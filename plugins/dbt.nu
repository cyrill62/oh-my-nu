# description: The dbt plugin adds several aliases for useful dbt commands and aliases (Oh My Zsh's dbt aliases)
# requires: dbt
# generated by tools/port-omz.py from Oh My Zsh's plugins/dbt
# not ported: dbtrtm (uses dbtrm)

export alias dbtlm = dbt ls -s state:modified
export alias dbtrm = dbt run -s state:modified
export alias dbttm = dbt test -m state:modified
# dbt clean; dbt deps; dbt seed
export def --wrapped dbtrs [...rest] { ^bash -c r#'dbt clean; dbt deps; dbt seed "$@"'# dbtrs ...$rest }
# dbtrs; dbt run --full-refresh; dbt test
export def --wrapped dbtfrt [...rest] { ^bash -c r#'dbtrs; dbt run --full-refresh; dbt test "$@"'# dbtfrt ...$rest }
# dbt docs generate; dbt docs serve
export def --wrapped dbtcds [...rest] { ^bash -c r#'dbt docs generate; dbt docs serve "$@"'# dbtcds ...$rest }
# dbt docs generate --no-compile; dbt docs serve
export def --wrapped dbtds [...rest] { ^bash -c r#'dbt docs generate --no-compile; dbt docs serve "$@"'# dbtds ...$rest }
