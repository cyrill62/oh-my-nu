# description: Oh My Zsh's pow aliases
# requires: 
# generated by tools/port-omz.py from Oh My Zsh's plugins/pow
# Oh My Zsh functions not ported: kapow, powed, powit, rack_root, rack_root_detect, repow

# tail -f ~/Library/Logs/Pow/apps/*
export def --wrapped kaput [...rest] { ^bash -c r#'tail -f ~/Library/Logs/Pow/apps/* "$@"'# kaput ...$rest }
