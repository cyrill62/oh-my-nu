# description: Oh My Zsh's multipass aliases
# requires: multipass
# generated by tools/port-omz.py from Oh My Zsh's plugins/multipass

export alias mp = multipass
export alias mpl = multipass list
export alias mpla = multipass launch
export alias mpln = multipass launch --network en0 --network name=bridge0,mode=manual
export alias mps = multipass shell
export alias mpsp = multipass stop
export alias mpst = multipass start
