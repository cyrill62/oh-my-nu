# description: Full alias list for Heroku CLI (Oh My Zsh's heroku-alias aliases)
# requires: heroku
# generated by tools/port-omz.py from Oh My Zsh's plugins/heroku-alias
# Oh My Zsh functions not ported: hcfile

export alias h = heroku
# heroku autocomplete $(echo $SHELL)
export def --wrapped hauto [...rest] { ^bash -c r#'heroku autocomplete $(echo $SHELL) "$@"'# hauto ...$rest }
export alias hl = heroku local
export alias hg = heroku logs
export alias hgt = heroku log tail
export alias hpg = heroku pg
export alias hpsql = heroku pg:psql
export alias hpb = heroku pg:backups
export alias hpbc = heroku pg:backups:capture
export alias hpbd = heroku pg:backups:download
export alias hpbr = heroku pg:backups:restore
export alias hc = heroku config
export alias hca = heroku config -a
export alias hcr = heroku config -r
export alias hcs = heroku config:set
export alias hcu = heroku config:unset
export alias ha = heroku apps
export alias hpop = heroku create
export alias hkill = heroku apps:destroy
export alias hlog = heroku apps:errors
export alias hfav = heroku apps:favorites
export alias hfava = heroku apps:favorites:add
export alias hfavr = heroku apps:favorites:remove
export alias hai = heroku apps:info
export alias hair = heroku apps:info -r
export alias haia = heroku apps:info -a
export alias h2fa = heroku auth:2fa
export alias h2far = heroku auth:2fa:disable
export alias hac = heroku access
export alias hacr = heroku access -r
export alias haca = heroku access -a
export alias hadd = heroku access:add
export alias hdel = heroku access:remove
export alias hup = heroku access:update
export alias hads = heroku addons -A
export alias hada = heroku addons -a
export alias hadr = heroku addons -r
export alias hadat = heroku addons:attach
export alias hadc = heroku addons:create
export alias hadel = heroku addons:destroy
export alias hadde = heroku addons:detach
export alias hadoc = heroku addons:docs
export alias hin = heroku login
export alias hout = heroku logout
export alias hi = heroku login -i
export alias hwho = heroku auth:whoami
export alias hth = heroku authorizations
export alias hthadd = heroku authorizations:create
export alias hthif = heroku authorizations:info
export alias hthdel = heroku authorizations:revoke
export alias hthrot = heroku authorizations:rotate
export alias hthup = heroku authorizations:update
export alias hp = heroku plugins
export alias hssl = heroku certs
