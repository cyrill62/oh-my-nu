# description: Oh My Zsh's poetry aliases
# requires: poetry

export alias pad = poetry add
export alias pbld = poetry build
export alias pch = poetry check
export alias pcmd = poetry list
export alias pconf = poetry config --list
export alias pexp = poetry export --without-hashes
export alias pin = poetry init
export alias pinst = poetry install
export alias plck = poetry lock
export alias pnew = poetry new
export alias ppath = poetry env info --path
export alias pplug = poetry self show plugins
export alias ppub = poetry publish
export alias prm = poetry remove
export alias prun = poetry run
export alias psad = poetry self add
export alias pshw = poetry show
export alias pslt = poetry show --latest
export alias psup = poetry self update
export alias psync = poetry sync
export alias ptree = poetry show --tree
export alias pup = poetry update
export alias pvinf = poetry env info
export alias pvrm = poetry env remove
export alias pvu = poetry env use
