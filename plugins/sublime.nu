# description: Oh My Zsh's sublime aliases
# requires: subl
# generated by tools/port-omz.py from Oh My Zsh's plugins/sublime
# not ported: st (uses subl); stt (uses subl); stp (uses find_project); stn (uses create_project)
# Oh My Zsh functions not ported: create_project, find_project

# '$_sublime_path'
export def --wrapped subl [...rest] { ^bash -c r#''$_sublime_path' "$@"'# subl ...$rest }
