# description: Oh My Zsh's laravel4 aliases
# requires: php
# generated by tools/port-omz.py from Oh My Zsh's plugins/laravel4
# Oh My Zsh functions not ported: _laravel4, _laravel4_get_command_list

export alias la4 = php artisan
export alias la4dump = php artisan dump-autoload
export alias la4cache = php artisan cache:clear
export alias la4routes = php artisan routes
