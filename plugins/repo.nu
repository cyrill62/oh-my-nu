# description: Oh My Zsh's repo aliases
# requires: repo
# generated by tools/port-omz.py from Oh My Zsh's plugins/repo

export alias r = repo
export alias rra = repo rebase --auto-stash
export alias rs = repo sync
# repo sync ; repo rebase --auto-stash
export def --wrapped rsrra [...rest] { ^bash -c r#'repo sync ; repo rebase --auto-stash "$@"'# rsrra ...$rest }
export alias ru = repo upload
export alias rst = repo status
export alias rsto = repo status -o
export alias rfa = repo forall -c
export alias rfap = repo forall -p -c
export alias rinf = repo info
