# description: Oh My Zsh's herdr aliases
# requires: herdr
# generated by tools/port-omz.py from Oh My Zsh's plugins/herdr
# Oh My Zsh functions not ported: herdr_prompt_info, hrdrs

export alias hrdr = herdr
export alias hrdrst = herdr status
export alias hrdrup = herdr update
export alias hrdrsl = herdr session list
export alias hrdrsa = herdr session attach
export alias hrdrr = herdr --remote
export alias hrdral = herdr agent list
export alias hrdrwl = herdr workspace list
export alias hrdrwc = herdr workspace create
export alias hrdrwt = herdr worktree create
export alias hrdrps = herdr pane split
export alias hrdrrc = herdr server reload-config
