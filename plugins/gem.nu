# description: Oh My Zsh's gem aliases
# requires: gem
# generated by tools/port-omz.py from Oh My Zsh's plugins/gem
# Oh My Zsh functions not ported: gemy

# gem build *.gemspec
export def --wrapped gemb [...rest] { ^bash -c r#'gem build *.gemspec "$@"'# gemb ...$rest }
# gem push *.gem
export def --wrapped gemp [...rest] { ^bash -c r#'gem push *.gem "$@"'# gemp ...$rest }
