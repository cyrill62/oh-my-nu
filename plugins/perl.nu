# description: Oh My Zsh's perl aliases
# requires: perl
# generated by tools/port-omz.py from Oh My Zsh's plugins/perl
# Oh My Zsh functions not ported: newpl, pgs, prep

export alias pbi = perlbrew install
export alias pbl = perlbrew list
export alias pbo = perlbrew off
export alias pbs = perlbrew switch
export alias pbu = perlbrew use
export alias pd = perldoc
export alias ple = perl -wlne
# curl -s https://www.perl.org/get.html | perl -wlne 'if (/perl\-([\d\.]+)\.tar\.gz/) { print $1; exi…
export def --wrapped latest-perl [...rest] { ^bash -c r#'curl -s https://www.perl.org/get.html | perl -wlne 'if (/perl\-([\d\.]+)\.tar\.gz/) { print $1; exit;}' "$@"'# latest-perl ...$rest }
