# description: Oh My Zsh's composer aliases
# requires: composer
# generated by tools/port-omz.py from Oh My Zsh's plugins/composer
# Oh My Zsh functions not ported: _composer

export alias c = composer
export alias ccp = composer create-project
export alias cdo = composer dump-autoload -o
export alias cdu = composer dump-autoload
# curl -s https://getcomposer.org/installer | php
export def --wrapped cget [...rest] { ^bash -c r#'curl -s https://getcomposer.org/installer | php "$@"'# cget ...$rest }
export alias cgr = composer global require
export alias cgrm = composer global remove
export alias cgu = composer global update
export alias ci = composer install
export alias co = composer outdated
export alias cod = composer outdated --direct
export alias cr = composer require
export alias crm = composer remove
export alias cs = composer show
export alias csu = composer self-update
export alias cu = composer update
# composer update --working-dir=$(composer config -g home)
export def --wrapped cuh [...rest] { ^bash -c r#'composer update --working-dir=$(composer config -g home) "$@"'# cuh ...$rest }
