# description: Oh My Zsh's mercurial aliases
# requires: hg
# generated by tools/port-omz.py from Oh My Zsh's plugins/mercurial
# Oh My Zsh functions not ported: hg_dirty, hg_get_bookmark_name, hg_get_branch_name, hg_prompt_info, hg_root, hgic, hgoc, in_hg

export alias hga = hg add
export alias hgc = hg commit
export alias hgca = hg commit --amend
export alias hgci = hg commit --interactive
export alias hgb = hg branch
export alias hgba = hg branches
export alias hgbk = hg bookmarks
export alias hgco = hg checkout
export alias hgd = hg diff
export alias hged = hg diffmerge
export alias hgp = hg push
export alias hgs = hg status
# hg log --limit 20 --template "{node|short} | {date|isodatesec} | {author|person}: {desc|strip|first…
export def --wrapped hgsl [...rest] { ^bash -c r#'hg log --limit 20 --template "{node|short} | {date|isodatesec} | {author|person}: {desc|strip|firstline}\n"  "$@"'# hgsl ...$rest }
export alias hgun = hg resolve --list
export alias hgi = hg incoming
export alias hgl = hg pull -u
export alias hglr = hg pull --rebase
export alias hgo = hg outgoing
export alias hglg = hg log --stat -v
export alias hglgp = hg log --stat -p -v
