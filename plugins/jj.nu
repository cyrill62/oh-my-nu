# description: Oh My Zsh's jj aliases
# requires: jj
# generated by tools/port-omz.py from Oh My Zsh's plugins/jj
# Oh My Zsh functions not ported: __jj_prompt_jj, jj_prompt_template, jj_prompt_template_raw

export alias jja = jj abandon
export alias jjb = jj bookmark
export alias jjba = jj bookmark advance
export alias jjbc = jj bookmark create
export alias jjbd = jj bookmark delete
export alias jjbf = jj bookmark forget
export alias jjbl = jj bookmark list
export alias jjblt = jj bookmark list --tracked
export alias jjbm = jj bookmark move
export alias jjbr = jj bookmark rename
export alias jjbs = jj bookmark set
export alias jjbt = jj bookmark track
export alias jjbu = jj bookmark untrack
export alias jjc = jj commit
export alias jjcfg = jj config
export alias jjcfgl = jj config list
export alias jjcmsg = jj commit --message
export alias jjd = jj diff
export alias jjdmsg = jj desc --message
export alias jjds = jj desc
export alias jjdst = jj diff --stat
export alias jje = jj edit
export alias jjev = jj evolog
export alias jjf = jj file
export alias jjfl = jj file list
export alias jjg = jj git
export alias jjgcl = jj git clone
export alias jjgf = jj git fetch
export alias jjgfa = jj git fetch --all-remotes
export alias jjgi = jj git init
export alias jjgp = jj git push
export alias jjgpa = jj git push --all
export alias jjgpd = jj git push --deleted
export alias jjgpt = jj git push --tracked
export alias jjgrl = jj git remote list
export alias jjl = jj log
# jj log -r "all()"
export def --wrapped jjla [...rest] { ^bash -c r#'jj log -r "all()" "$@"'# jjla ...$rest }
export alias jjn = jj new
# jj new "trunk()"
export def --wrapped jjnt [...rest] { ^bash -c r#'jj new "trunk()" "$@"'# jjnt ...$rest }
export alias jjop = jj op
export alias jjopl = jj op log
export alias jjor = jj op restore
export alias jjrb = jj rebase
# jj rebase -o "trunk()"
export def --wrapped jjrbm [...rest] { ^bash -c r#'jj rebase -o "trunk()" "$@"'# jjrbm ...$rest }
export alias jjrs = jj restore
# cd "$(jj root || echo .)"
export def --wrapped jjrt [...rest] { ^bash -c r#'cd "$(jj root || echo .)" "$@"'# jjrt ...$rest }
export alias jjs = jj show
export alias jjsp = jj split
export alias jjsq = jj squash
export alias jjst = jj status
export alias jju = jj undo
export alias jjw = jj workspace
export alias jjwa = jj workspace add
export alias jjwf = jj workspace forget
export alias jjwl = jj workspace list
