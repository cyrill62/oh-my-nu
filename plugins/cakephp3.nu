# description: Oh My Zsh's cakephp3 aliases
# requires: 
# generated by tools/port-omz.py from Oh My Zsh's plugins/cakephp3
# Oh My Zsh functions not ported: _cakephp3, _cakephp3_get_3rd_argument, _cakephp3_get_command_list, _cakephp3_get_sub_command_list

export alias c3 = bin/cake
export alias c3cache = bin/cake schema_cache clear
export alias c3migrate = bin/cake migrations migrate
