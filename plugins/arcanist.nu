# description: Oh My Zsh's arcanist aliases
# requires: arc
# generated by tools/port-omz.py from Oh My Zsh's plugins/arcanist
# Oh My Zsh functions not ported: ardu, arpa

export alias ara = arc amend
export alias arb = arc branch
export alias arbl = arc bland
export alias arco = arc cover
export alias arci = arc commit
export alias ard = arc diff
export alias ardc = arc diff --create
export alias ardnu = arc diff --nounit
export alias ardnupc = arc diff --nounit --plan-changes
export alias ardpc = arc diff --plan-changes
export alias ardp = arc diff --preview
export alias are = arc export
export alias arh = arc help
export alias arho = arc hotfix
export alias arl = arc land
export alias arli = arc lint
export alias arls = arc list
