# description: Oh My Zsh's rake aliases
# requires: rake
# generated by tools/port-omz.py from Oh My Zsh's plugins/rake
# not ported: jimweirich (uses rake)

export def --wrapped main [...rest] { ^rake ...$rest }
export alias 'bin/rake' = bin/rake
export alias brake = bundle exec rake
export alias srake = sudo rake
export alias sbrake = sudo bundle exec rake
