# description: Oh My Zsh's supervisor aliases
# requires: supervisorctl
# generated by tools/port-omz.py from Oh My Zsh's plugins/supervisor

export alias sup = sudo supervisorctl
export alias supad = sudo supervisorctl add
export alias supa = sudo supervisorctl avail
export alias suprl = sudo supervisorctl reload
export alias suprm = sudo supervisorctl remove
export alias suprr = sudo supervisorctl reread
export alias suprs = sudo supervisorctl restart
export alias sups = sudo supervisorctl status
export alias supsr = sudo supervisorctl start
export alias supso = sudo supervisorctl stop
export alias supt = sudo supervisorctl tail
export alias supu = sudo supervisorctl update
