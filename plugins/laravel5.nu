# description: Oh My Zsh's laravel5 aliases
# requires: php
# generated by tools/port-omz.py from Oh My Zsh's plugins/laravel5
# Oh My Zsh functions not ported: _laravel5, _laravel5_get_command_list

export alias la5 = php artisan
export alias la5cache = php artisan cache:clear
export alias la5routes = php artisan route:list
export alias la5vendor = php artisan vendor:publish
