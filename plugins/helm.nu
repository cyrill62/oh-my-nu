# description: helm shortcuts (Oh My Zsh's helm names)
# requires: helm

export alias h = helm
export alias hin = helm install
export alias hun = helm uninstall
export alias hse = helm search
export alias hup = helm upgrade
export alias hls = helm list
export alias hst = helm status
export alias hrb = helm rollback
export alias hhi = helm history
export alias hrepo = helm repo
export alias hrepou = helm repo update
