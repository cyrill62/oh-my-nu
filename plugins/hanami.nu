# description: Oh My Zsh's hanami aliases
# requires: hanami
# generated by tools/port-omz.py from Oh My Zsh's plugins/hanami
# not ported: hdrs (uses hdd); hdtp (uses HET); hrg (uses hr)

export alias HED = HANAMI_ENV=development
export alias HEP = HANAMI_ENV=production
export alias HET = HANAMI_ENV=test
export alias hc = hanami console
export alias hd = hanami destroy
export alias hg = hanami generate
export alias hgm = hanami generate migration
export alias hs = hanami server
export alias hsp = hanami server -p
export alias hr = hanami routes
export alias hdc = hanami db create
export alias hdd = hanami db drop
export alias hdp = hanami db prepare
export alias hda = hanami db apply
export alias hdv = hanami db version
