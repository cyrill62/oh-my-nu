# description: Oh My Zsh's hanami aliases
# requires: hanami
# generated by tools/port-omz.py from Oh My Zsh's plugins/hanami

# HANAMI_ENV=development, then the command line
export def --wrapped HED [...rest] { with-env {HANAMI_ENV: "development"} { run-external ...$rest } }
# HANAMI_ENV=production, then the command line
export def --wrapped HEP [...rest] { with-env {HANAMI_ENV: "production"} { run-external ...$rest } }
# HANAMI_ENV=test, then the command line
export def --wrapped HET [...rest] { with-env {HANAMI_ENV: "test"} { run-external ...$rest } }
export alias hc = hanami console
export alias hd = hanami destroy
export alias hg = hanami generate
export alias hgm = hanami generate migration
export alias hs = hanami server
export alias hsp = hanami server -p
export alias hr = hanami routes
export alias hdc = hanami db create
export alias hdd = hanami db drop
export alias hdp = hanami db prepare
export alias hda = hanami db apply
export alias hdv = hanami db version
# hanami db drop && hanami db prepare
export def --wrapped hdrs [...rest] { ^bash -c r#'hanami db drop && hanami db prepare "$@"'# hdrs ...$rest }
# HANAMI_ENV=test hanami db prepare
export def --wrapped hdtp [...rest] { with-env {HANAMI_ENV: "test"} { ^hanami db prepare ...$rest } }
# hanami routes | grep
export def --wrapped hrg [...rest] { ^bash -c r#'hanami routes | grep "$@"'# hrg ...$rest }
