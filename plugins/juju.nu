# description: Oh My Zsh's juju aliases
# requires: juju
# generated by tools/port-omz.py from Oh My Zsh's plugins/juju
# Oh My Zsh functions not ported: jaddr, jclean, jcontroller, jmodel, jreld, wjst

export alias j = juju
# juju add-model --config logging-config="<root>=WARNING; unit=DEBUG" --config update-status-hook-int…
export def --wrapped jam [...rest] { ^bash -c r#'juju add-model --config logging-config="<root>=WARNING; unit=DEBUG" --config update-status-hook-interval="60m" "$@"'# jam ...$rest }
export alias jb = juju bootstrap
export alias jbng = juju bootstrap --no-gui
export alias jbl = juju bootstrap localhost
export alias jblng = juju bootstrap --no-gui localhost
export alias jbm = juju bootstrap microk8s
export alias jbmng = juju bootstrap --no-gui microk8s
export alias jc = juju config
export alias jcld = juju clouds
export alias jclda = juju clouds --all
export alias jctl = juju controllers
export alias jctlr = juju controllers --refresh
export alias jdc = juju destroy-controller --destroy-all-models
export alias 'jdc!' = juju destroy-controller --destroy-all-models --force --no-wait -y
export alias jdcds = juju destroy-controller --destroy-all-models --destroy-storage
export alias 'jdcds!' = juju destroy-controller --destroy-all-models --destroy-storage --force --no-wait -y
export alias jdm = juju destroy-model
export alias 'jdm!' = juju destroy-model --force --no-wait -y
export alias jdmds = juju destroy-model --destroy-storage
export alias 'jdmds!' = juju destroy-model --destroy-storage --force --no-wait -y
export alias jde = juju deploy --channel=edge
export alias jd = juju deploy
export alias jdl = juju debug-log --ms
export alias jdlr = juju debug-log --ms --replay
export alias jcon = juju consume
export alias jeb = juju export-bundle
export alias jex = juju expose
export alias junex = juju unexpose
export alias jh = juju help
export alias jkc = juju kill-controller -y -t 0
export alias jm = juju models
export alias jmc = juju model-config
export alias jof = juju offer
export alias jra = juju run-action
export alias jraw = juju run-action --wait
export alias jrel = juju relate
export alias jrm = juju remove-application
export alias 'jrm!' = juju remove-application --force --no-wait
export alias jrmds = juju remove-application --destroy-storage
export alias 'jrmds!' = juju remove-application --destroy-storage --force --no-wait
export alias jrmrel = juju remove-relation
export alias 'jrmrel!' = juju remove-relation --force
export alias jrmsas = juju remove-saas
export alias jrp = juju refresh --path
export alias jrs = juju remove-storage
export alias 'jrs!' = juju remove-storage --force
export alias jsa = juju scale-application
export alias jsha = juju show-application
export alias jshc = juju show-controller
export alias jshm = juju show-model
export alias jshsl = juju show-status-log
export alias jshu = juju show-unit
export alias jssh = juju ssh
export alias jsshc = juju ssh --container
export alias jstj = juju status --format=json
export alias jst = juju status --relations --color
export alias jsts = juju status --relations --storage --color
export alias jsw = juju switch
