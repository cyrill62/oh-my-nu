# description: Oh My Zsh's bundler aliases
# requires: bundle
# generated by tools/port-omz.py from Oh My Zsh's plugins/bundler
# Oh My Zsh functions not ported: _run-with-bundler, _within-bundled-project

export alias ba = bundle add
export alias bck = bundle check
export alias bcn = bundle clean
export alias be = bundle exec
export alias bi = bundle install
export alias bl = bundle list
export alias bo = bundle open
export alias bout = bundle outdated
export alias bp = bundle package
export alias bu = bundle update
export alias bua = bundle update --all
# bundled_$cmd
export def --wrapped '$cmd' [...rest] { ^bash -c r#'bundled_$cmd "$@"'# '$cmd' ...$rest }
