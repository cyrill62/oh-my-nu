# description: Zeus preloads your Rails environment and forks that process whenever needed (Oh My Zsh's zeus aliases)
# requires: zeus
# generated by tools/port-omz.py from Oh My Zsh's plugins/zeus

export alias zi = zeus init
export alias zinit = zeus init
export alias zs = zeus start
export alias ztart = zeus start
export alias zc = zeus console
export alias zonsole = zeus console
export alias zsr = zeus server
export alias zerver = zeus server
export alias zr = zeus rake
export alias zake = zeus rake
export alias zg = zeus generate
export alias zenerate = zeus generate
export alias zrn = zeus runner
export alias zunner = zeus runner
export alias zcu = zeus cucumber
export alias zucumber = zeus cucumber
export alias zwip = zeus cucumber --profile wip
export alias zspec = zeus rspec
export alias zt = zeus test
export alias zest = zeus test
# zeus test test/unit/*
export def --wrapped zu [...rest] { ^bash -c r#'zeus test test/unit/* "$@"'# zu ...$rest }
# zeus test test/unit/*
export def --wrapped zunits [...rest] { ^bash -c r#'zeus test test/unit/* "$@"'# zunits ...$rest }
# zeus test test/functional/*
export def --wrapped zf [...rest] { ^bash -c r#'zeus test test/functional/* "$@"'# zf ...$rest }
# zeus test test/functional/*
export def --wrapped zunctional [...rest] { ^bash -c r#'zeus test test/functional/* "$@"'# zunctional ...$rest }
# zeus test test/unit/*; zeus test test/functional/; zeus cucumber
export def --wrapped za [...rest] { ^bash -c r#'zeus test test/unit/*; zeus test test/functional/; zeus cucumber "$@"'# za ...$rest }
# zeus test test/unit/*; zeus test test/functional/; zeus cucumber
export def --wrapped zall [...rest] { ^bash -c r#'zeus test test/unit/*; zeus test test/functional/; zeus cucumber "$@"'# zall ...$rest }
export alias zsw = ^rm .zeus.sock
export alias zweep = ^rm .zeus.sock
export alias zdbr = zeus rake db:reset db:test:prepare
export alias zdbreset = zeus rake db:reset db:test:prepare
export alias zdbm = zeus rake db:migrate db:test:prepare
export alias zdbmigrate = zeus rake db:migrate db:test:prepare
export alias zdbc = zeus rake db:create
export alias zdbcm = zeus rake db:create db:migrate db:test:prepare
