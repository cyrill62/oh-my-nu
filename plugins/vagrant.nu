# description: vagrant shortcuts (Oh My Zsh's vagrant names)
# requires: vagrant

export alias vgi = vagrant init
export alias vup = vagrant up
export alias vd = vagrant destroy
export alias vdf = vagrant destroy --force
export alias vh = vagrant halt
export alias vssh = vagrant ssh
export alias vst = vagrant status
export alias vgs = vagrant global-status
export alias vr = vagrant reload
export alias vrp = vagrant reload --provision
export alias vp = vagrant push
export alias vba = vagrant box add
export alias vbl = vagrant box list
export alias vbu = vagrant box update
export alias vsshc = vagrant ssh-config
export alias vrdp = vagrant rdp
export alias vssp = vagrant suspend
export alias vre = vagrant resume
export alias vpr = vagrant provision
export alias vsh = vagrant share
export alias vbr = vagrant box remove
export alias vbo = vagrant box outdated
export alias vpli = vagrant plugin install
export alias vpll = vagrant plugin list
export alias vplun = vagrant plugin uninstall
export alias vplu = vagrant plugin update
