# description: The primary job of this plugin is to provide rbenv_prompt_info which can be added to your theme to include Rub (Oh My Zsh's rbenv aliases)
# requires: rbenv
# generated by tools/port-omz.py from Oh My Zsh's plugins/rbenv
# Oh My Zsh functions not ported: current_gemset, current_ruby, gems, gemsets, rbenv_prompt_info

export alias rubies = rbenv versions
export alias gemsets = rbenv gemset list
