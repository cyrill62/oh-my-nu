# description: Oh My Zsh's drush aliases
# requires: drush
# generated by tools/port-omz.py from Oh My Zsh's plugins/drush
# Oh My Zsh functions not ported: dren, drf, drfi, dris, drnew, drpu

export alias dr = drush
export alias drca = drush cc all
export alias drcb = drush cc block
export alias drcex = drush config:export -y
export alias drcg = drush cc registry
export alias drcim = drush config:import -y
export alias drcj = drush cc css-js
export alias drcm = drush cc menu
export alias drcml = drush cc module-list
export alias drcr = drush core-cron
export alias drct = drush cc theme-registry
export alias drcv = drush cc views
export alias drdmp = drush sql-dump --ordered-dump --result-file=dump.sql
export alias drf = drush features
export alias drfr = drush features-revert -y
export alias drfra = drush features-revert-all
export alias drfu = drush features-update -y
export alias drif = drush image-flush --all
export alias drpm = drush pm-list --type=module
export alias drst = drush core-status
export alias druli = drush user:login
export alias drup = drush updatedb
export alias drups = drush updatedb-status
export alias drv = drush version
export alias drvd = drush variable-del
export alias drvg = drush variable-get
export alias drvs = drush variable-set
export alias drws = drush watchdog:show
export alias drwse = drush watchdog:show --extended
export alias drwst = drush watchdog:tail
